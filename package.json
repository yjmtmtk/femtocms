{
  "name": "femtocms",
  "version": "0.1.0",
  "description": "A headless, UI-less CMS on Cloudflare Workers + D1 + R2, operated via MCP, CLI and HTTP API",
  "keywords": [
    "cms",
    "headless",
    "cloudflare",
    "workers",
    "d1",
    "r2",
    "mcp",
    "ai"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "femtocms": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "worker/migrations",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "node scripts/build-worker.mjs && tsup",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "wrangler": "^4.165.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
